# Copy this file to `.env` and fill in your own values.  `.env` is ignored by git
# and is never printed or logged by VulnMirage.
#
#   cp .env.example .env
#
# Existing process environment variables take precedence over this file.  An
# alternative file can be selected per command:
#
#   vulnmirage --env-file /secure/path/vulnmirage.env campaign run ...
#
# Only the providers used by your agent configs need to be set; the agent config
# names each variable it needs in `requires_env`, and `vulnmirage doctor` reports
# presence by name (never the value).
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
ZHIPU_API_KEY=replace-with-your-zhipu-key
DASHSCOPE_API_KEY=replace-with-your-dashscope-key

# Optional: point at a specific env file instead of ./.env or the project .env.
# VULNMIRAGE_ENV_FILE=.env
