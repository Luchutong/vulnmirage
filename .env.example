# Copy this file to `.env` and fill in your own values.  `.env` is ignored by
# git and is never printed or logged by VulnMirage.
#
#   cp .env.example .env
#
# Existing process environment variables take precedence over this file.  An
# alternative file can be selected per command:
#
#   vulnmirage --env-file /secure/path/vulnmirage.env generate ...
#
# or through VULNMIRAGE_ENV_FILE (paths are relative to the current directory).
#
# OpenAI-compatible endpoint used by generation.backend=llm|hybrid.
VULNMIRAGE_LLM_BASE_URL=https://api.example.com/v1
VULNMIRAGE_LLM_API_KEY=replace-with-your-key
VULNMIRAGE_LLM_MODEL=replace-with-your-model

# Credentials forwarded to OpenCode for real-agent experiments.  Configure
# only the providers included in the experiment matrix.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
ZHIPU_API_KEY=replace-with-your-zhipu-key
DASHSCOPE_API_KEY=replace-with-your-dashscope-key

# Optional: point at a specific env file instead of ./.env or the project .env.
# VULNMIRAGE_ENV_FILE=.env
