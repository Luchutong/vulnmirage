{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One executable condition: the clean baseline or one attacked variant.",
  "properties": {
    "candidate_budget": {
      "default": 1,
      "maximum": 64,
      "minimum": 1,
      "title": "Candidate Budget",
      "type": "integer"
    },
    "condition_id": {
      "title": "Condition Id",
      "type": "string"
    },
    "dose": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dose"
    },
    "generator_profile": {
      "default": "default",
      "title": "Generator Profile",
      "type": "string"
    },
    "generator_tier": {
      "default": "T0",
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "title": "Generator Tier",
      "type": "string"
    },
    "intensity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intensity"
    },
    "kind": {
      "default": "attacked",
      "enum": [
        "clean",
        "attacked"
      ],
      "title": "Kind",
      "type": "string"
    },
    "method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Id"
    },
    "objective": {
      "default": "none",
      "title": "Objective",
      "type": "string"
    },
    "primary_mechanism": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Mechanism"
    },
    "realization_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realization Id"
    },
    "selection_policy": {
      "default": "semantic_fit_then_deterministic_tiebreak",
      "title": "Selection Policy",
      "type": "string"
    },
    "surface": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surface"
    },
    "taxonomy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taxonomy Version"
    },
    "threat_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threat Model Id"
    },
    "victim_feedback": {
      "default": false,
      "title": "Victim Feedback",
      "type": "boolean"
    }
  },
  "required": [
    "condition_id"
  ],
  "title": "ConditionSpec",
  "type": "object"
}
