{
  "$defs": {
    "ProbeTarget": {
      "additionalProperties": false,
      "properties": {
        "addresses": {
          "items": {
            "type": "string"
          },
          "title": "Addresses",
          "type": "array"
        },
        "connected": {
          "default": false,
          "title": "Connected",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 443,
          "title": "Port",
          "type": "integer"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "host"
      ],
      "title": "ProbeTarget",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocked_targets": {
      "items": {
        "$ref": "#/$defs/ProbeTarget"
      },
      "title": "Blocked Targets",
      "type": "array"
    },
    "enforcement": {
      "title": "Enforcement",
      "type": "string"
    },
    "enforcement_verified": {
      "default": false,
      "title": "Enforcement Verified",
      "type": "boolean"
    },
    "gateway_reachable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gateway Reachable"
    },
    "gateway_targets": {
      "items": {
        "$ref": "#/$defs/ProbeTarget"
      },
      "title": "Gateway Targets",
      "type": "array"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "probe_origin": {
      "default": "campaign_host",
      "enum": [
        "campaign_host",
        "agent_network_boundary"
      ],
      "title": "Probe Origin",
      "type": "string"
    },
    "probe_timeout_seconds": {
      "title": "Probe Timeout Seconds",
      "type": "number"
    },
    "probed_at": {
      "title": "Probed At",
      "type": "string"
    },
    "reachable_answer_hosts": {
      "items": {
        "type": "string"
      },
      "title": "Reachable Answer Hosts",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "default": "unknown",
      "enum": [
        "open",
        "observed_unreachable",
        "enforced_blocked",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "enforcement",
    "probe_timeout_seconds"
  ],
  "title": "EgressProbeResult",
  "type": "object"
}
