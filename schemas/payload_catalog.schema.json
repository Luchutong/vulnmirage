{
  "$defs": {
    "AttackMethod": {
      "additionalProperties": false,
      "properties": {
        "causal_hypothesis": {
          "$ref": "#/$defs/CausalHypothesis"
        },
        "evaluation_contract": {
          "$ref": "#/$defs/EvaluationContract"
        },
        "intensity_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/IntensityProfile"
          },
          "propertyNames": {
            "enum": [
              "I0",
              "I1",
              "I2",
              "I3",
              "I4"
            ]
          },
          "title": "Intensity Profiles",
          "type": "object"
        },
        "mechanism": {
          "$ref": "#/$defs/MechanismSpec"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "supported_objectives": {
          "items": {
            "enum": [
              "O-FN",
              "O-FP",
              "O-SEV-D",
              "O-SEV-I",
              "O-EV",
              "O-SCOPE",
              "O-AVAIL"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Objectives",
          "type": "array"
        },
        "supported_surfaces": {
          "items": {
            "$ref": "#/$defs/AttackSurface"
          },
          "minItems": 1,
          "title": "Supported Surfaces",
          "type": "array"
        },
        "taxonomy_version": {
          "default": "vm-atk-1.0",
          "title": "Taxonomy Version",
          "type": "string"
        }
      },
      "required": [
        "method_id",
        "name",
        "mechanism",
        "supported_objectives",
        "causal_hypothesis",
        "supported_surfaces",
        "intensity_profiles",
        "evaluation_contract"
      ],
      "title": "AttackMethod",
      "type": "object"
    },
    "AttackSurface": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "enum": [
            "S-DOC",
            "S-RULE",
            "S-COMMENT",
            "S-CODE",
            "S-CONFIG",
            "S-TEST",
            "S-META",
            "S-GENERATED",
            "S-TOOL"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "zone": {
          "enum": [
            "Z-AUTO",
            "Z-ROOT",
            "Z-TARGET",
            "Z-ENTRY",
            "Z-SINK",
            "Z-PATH",
            "Z-PERIPHERAL"
          ],
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "zone"
      ],
      "title": "AttackSurface",
      "type": "object"
    },
    "CausalHypothesis": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "title": "Alternative Explanations",
          "type": "array"
        },
        "behavior": {
          "minLength": 1,
          "title": "Behavior",
          "type": "string"
        },
        "exposure": {
          "minLength": 1,
          "title": "Exposure",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "uptake": {
          "minLength": 1,
          "title": "Uptake",
          "type": "string"
        }
      },
      "required": [
        "exposure",
        "uptake",
        "behavior",
        "outcome"
      ],
      "title": "CausalHypothesis",
      "type": "object"
    },
    "EvaluationContract": {
      "additionalProperties": false,
      "properties": {
        "intermediate_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Intermediate Metrics",
          "type": "array"
        },
        "primary_metric": {
          "minLength": 1,
          "title": "Primary Metric",
          "type": "string"
        }
      },
      "required": [
        "primary_metric"
      ],
      "title": "EvaluationContract",
      "type": "object"
    },
    "IntensityProfile": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_claims": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Claims",
          "type": "integer"
        },
        "max_supporting_evidence": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Supporting Evidence",
          "type": "integer"
        }
      },
      "required": [
        "description"
      ],
      "title": "IntensityProfile",
      "type": "object"
    },
    "MechanismSpec": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ],
          "title": "Class",
          "type": "string"
        },
        "modifiers": {
          "items": {
            "type": "string"
          },
          "title": "Modifiers",
          "type": "array"
        },
        "primary": {
          "title": "Primary",
          "type": "string"
        }
      },
      "required": [
        "class",
        "primary"
      ],
      "title": "MechanismSpec",
      "type": "object"
    },
    "MethodPlacementLimits": {
      "additionalProperties": false,
      "properties": {
        "max_files_changed": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Files Changed",
          "type": "integer"
        },
        "max_inserted_lines": {
          "default": 8,
          "maximum": 400,
          "minimum": 1,
          "title": "Max Inserted Lines",
          "type": "integer"
        },
        "max_payload_chars": {
          "default": 4000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Payload Chars",
          "type": "integer"
        }
      },
      "title": "MethodPlacementLimits",
      "type": "object"
    },
    "MethodValidationPolicy": {
      "additionalProperties": false,
      "properties": {
        "answer_token_scan": {
          "default": true,
          "title": "Answer Token Scan",
          "type": "boolean"
        },
        "build_equivalence": {
          "default": "when_profile_available",
          "enum": [
            "required",
            "when_profile_available",
            "not_applicable"
          ],
          "title": "Build Equivalence",
          "type": "string"
        },
        "parse_required": {
          "default": true,
          "title": "Parse Required",
          "type": "boolean"
        },
        "target_remap_required": {
          "default": true,
          "title": "Target Remap Required",
          "type": "boolean"
        }
      },
      "title": "MethodValidationPolicy",
      "type": "object"
    },
    "PayloadRealizationDefinition": {
      "additionalProperties": false,
      "description": "One concrete expression of a method at one surface and intensity.",
      "properties": {
        "allowed_threat_models": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Threat Models",
          "type": "array"
        },
        "carrier": {
          "title": "Carrier",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "dose": {
          "$ref": "#/$defs/RealizationDose"
        },
        "generator_backends": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Generator Backends",
          "type": "object"
        },
        "inspiration_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspiration Scope"
        },
        "intensity": {
          "enum": [
            "I0",
            "I1",
            "I2",
            "I3",
            "I4"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "known_deviations": {
          "items": {
            "type": "string"
          },
          "title": "Known Deviations",
          "type": "array"
        },
        "language": {
          "default": "repository_native",
          "title": "Language",
          "type": "string"
        },
        "method_id": {
          "title": "Method Id",
          "type": "string"
        },
        "objective": {
          "enum": [
            "O-FN",
            "O-FP",
            "O-SEV-D",
            "O-SEV-I",
            "O-EV",
            "O-SCOPE",
            "O-AVAIL"
          ],
          "title": "Objective",
          "type": "string"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Path"
        },
        "placement": {
          "enum": [
            "create_file",
            "target_file_footer",
            "safe_decoy_file"
          ],
          "title": "Placement",
          "type": "string"
        },
        "placement_limits": {
          "$ref": "#/$defs/MethodPlacementLimits"
        },
        "private_safety_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Safety Basis"
        },
        "realization_id": {
          "title": "Realization Id",
          "type": "string"
        },
        "reproduction_status": {
          "enum": [
            "implemented_adaptation",
            "planned"
          ],
          "title": "Reproduction Status",
          "type": "string"
        },
        "safe_decoy_cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Safe Decoy Cwe Ids",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "supported_generator_tiers": {
          "items": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4"
            ],
            "type": "string"
          },
          "title": "Supported Generator Tiers",
          "type": "array"
        },
        "surface": {
          "$ref": "#/$defs/AttackSurface"
        },
        "template": {
          "title": "Template",
          "type": "string"
        },
        "templates": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Templates",
          "type": "object"
        },
        "validation": {
          "$ref": "#/$defs/MethodValidationPolicy"
        }
      },
      "required": [
        "realization_id",
        "method_id",
        "objective",
        "surface",
        "intensity",
        "dose",
        "reproduction_status",
        "carrier",
        "placement",
        "template"
      ],
      "title": "PayloadRealizationDefinition",
      "type": "object"
    },
    "RealizationDose": {
      "additionalProperties": false,
      "description": "Auditable dose supplied by one concrete realization.\n\nThese counts are author-declared structural properties of the payload, not a\npost-hoc estimate of how persuasive it was. Catalog validation checks them\nagainst both the method-specific profile and the generic I0-I4 ordering.",
      "properties": {
        "claim_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Claim Count",
          "type": "integer"
        },
        "directness": {
          "enum": [
            "implicit",
            "explicit"
          ],
          "title": "Directness",
          "type": "string"
        },
        "reinforcement_count": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Reinforcement Count",
          "type": "integer"
        },
        "supporting_evidence_count": {
          "maximum": 32,
          "minimum": 0,
          "title": "Supporting Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "claim_count",
        "supporting_evidence_count",
        "directness"
      ],
      "title": "RealizationDose",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "method_definitions": {
      "items": {
        "$ref": "#/$defs/AttackMethod"
      },
      "minItems": 1,
      "title": "Method Definitions",
      "type": "array"
    },
    "realizations": {
      "items": {
        "$ref": "#/$defs/PayloadRealizationDefinition"
      },
      "minItems": 1,
      "title": "Realizations",
      "type": "array"
    },
    "schema_version": {
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "taxonomy_version": {
      "default": "vm-atk-1.0",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "threat_model_files": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Threat Model Files",
      "type": "array"
    }
  },
  "required": [
    "threat_model_files",
    "method_definitions",
    "realizations"
  ],
  "title": "PayloadCatalog",
  "type": "object"
}
