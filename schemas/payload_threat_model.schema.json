{
  "$defs": {
    "MutationConstraints": {
      "additionalProperties": false,
      "properties": {
        "executable_behavior_must_remain_equivalent": {
          "default": true,
          "title": "Executable Behavior Must Remain Equivalent",
          "type": "boolean"
        },
        "max_files_changed": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Files Changed",
          "type": "integer"
        }
      },
      "title": "MutationConstraints",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attacker_controls": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Attacker Controls",
      "type": "array"
    },
    "feedback_access": {
      "default": "none",
      "enum": [
        "none",
        "surrogate",
        "victim"
      ],
      "title": "Feedback Access",
      "type": "string"
    },
    "forbidden_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Capabilities",
      "type": "array"
    },
    "mutation_constraints": {
      "$ref": "#/$defs/MutationConstraints"
    },
    "oracle_access": {
      "items": {
        "type": "string"
      },
      "title": "Oracle Access",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "taxonomy_version": {
      "default": "vm-atk-1.0",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "threat_model_id": {
      "minLength": 1,
      "title": "Threat Model Id",
      "type": "string"
    }
  },
  "required": [
    "threat_model_id",
    "attacker_controls"
  ],
  "title": "ThreatModel",
  "type": "object"
}
