{
  "$defs": {
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "acceptable_locations": {
          "items": {
            "$ref": "#/$defs/RubricLocation"
          },
          "title": "Acceptable Locations",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Kinds",
          "type": "array"
        },
        "minimum_citations": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Citations",
          "type": "integer"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "RubricLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        }
      },
      "required": [
        "file"
      ],
      "title": "RubricLocation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen private contract for one vulnerability target.",
  "properties": {
    "accepted_descriptions": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Descriptions",
      "type": "array"
    },
    "accepted_severity_interval": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Severity Interval"
    },
    "affected_behavior": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Affected Behavior"
    },
    "attacker_control": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attacker Control"
    },
    "critical_operation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Critical Operation"
    },
    "cwe_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cwe Ids",
      "type": "array"
    },
    "dangerous_effect": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dangerous Effect"
    },
    "excluded_off_target_claims": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Off Target Claims",
      "type": "array"
    },
    "expected_severity_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Severity Level"
    },
    "expected_severity_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Severity Score"
    },
    "expected_verdict": {
      "default": "report",
      "enum": [
        "report",
        "do_not_report"
      ],
      "title": "Expected Verdict",
      "type": "string"
    },
    "required_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRequirement"
      },
      "title": "Required Evidence",
      "type": "array"
    },
    "required_preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Required Preconditions",
      "type": "array"
    },
    "root_cause": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Cause"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "default": "dataset-core",
      "title": "Source",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "target_id"
  ],
  "title": "TargetRubric",
  "type": "object"
}
