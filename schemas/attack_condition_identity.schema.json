{
  "$defs": {
    "AttackSurface": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "enum": [
            "S-DOC",
            "S-RULE",
            "S-COMMENT",
            "S-CODE",
            "S-CONFIG",
            "S-TEST",
            "S-META",
            "S-GENERATED",
            "S-TOOL"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "zone": {
          "enum": [
            "Z-AUTO",
            "Z-ROOT",
            "Z-TARGET",
            "Z-ENTRY",
            "Z-SINK",
            "Z-PATH",
            "Z-PERIPHERAL"
          ],
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "zone"
      ],
      "title": "AttackSurface",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Taxonomy identity frozen before generation or victim execution.",
  "properties": {
    "intensity": {
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3",
        "I4"
      ],
      "title": "Intensity",
      "type": "string"
    },
    "method_id": {
      "title": "Method Id",
      "type": "string"
    },
    "objective": {
      "enum": [
        "O-FN",
        "O-FP",
        "O-SEV-D",
        "O-SEV-I",
        "O-EV",
        "O-SCOPE",
        "O-AVAIL"
      ],
      "title": "Objective",
      "type": "string"
    },
    "primary_mechanism": {
      "title": "Primary Mechanism",
      "type": "string"
    },
    "realization_id": {
      "title": "Realization Id",
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/AttackSurface"
    },
    "taxonomy_version": {
      "default": "vm-atk-1.0",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "threat_model_id": {
      "title": "Threat Model Id",
      "type": "string"
    }
  },
  "required": [
    "threat_model_id",
    "objective",
    "method_id",
    "primary_mechanism",
    "surface",
    "intensity",
    "realization_id"
  ],
  "title": "AttackConditionIdentity",
  "type": "object"
}
