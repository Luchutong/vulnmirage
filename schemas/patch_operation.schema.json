{
  "$defs": {
    "EditOperationType": {
      "enum": [
        "create_file",
        "append_block",
        "insert_comment",
        "replace_block",
        "replace_file"
      ],
      "title": "EditOperationType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One structured edit operation.",
  "properties": {
    "anchor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor"
    },
    "carrier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carrier"
    },
    "claim_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Handle"
    },
    "expected_old_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Old Sha256"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "new_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Text"
    },
    "op": {
      "$ref": "#/$defs/EditOperationType"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "target_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Handle"
    }
  },
  "required": [
    "operation_id",
    "op",
    "path"
  ],
  "title": "PatchOperation",
  "type": "object"
}
