{
  "$defs": {
    "PlanTierProfile": {
      "additionalProperties": false,
      "description": "The generation rules a tier is frozen with (design §5.1).",
      "properties": {
        "candidate_budget": {
          "default": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "generator_profile": {
          "default": "default",
          "title": "Generator Profile",
          "type": "string"
        },
        "max_files_changed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Files Changed"
        },
        "max_inserted_lines": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Inserted Lines"
        },
        "max_model_calls": {
          "default": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_payload_chars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Payload Chars"
        },
        "selection_policy": {
          "default": "semantic_fit_then_deterministic_tiebreak",
          "title": "Selection Policy",
          "type": "string"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier"
      ],
      "title": "PlanTierProfile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_budget": {
      "default": 3,
      "title": "Candidate Budget",
      "type": "integer"
    },
    "require_candidate_validation": {
      "default": true,
      "title": "Require Candidate Validation",
      "type": "boolean"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "tier_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/PlanTierProfile"
      },
      "title": "Tier Profiles",
      "type": "object"
    }
  },
  "title": "PlanGeneration",
  "type": "object"
}
