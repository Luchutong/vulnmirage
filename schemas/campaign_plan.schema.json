{
  "$defs": {
    "PlanBudget": {
      "additionalProperties": false,
      "properties": {
        "audits_per_task": {
          "default": 0,
          "title": "Audits Per Task",
          "type": "integer"
        },
        "max_tasks": {
          "default": 1,
          "title": "Max Tasks",
          "type": "integer"
        },
        "max_workers": {
          "default": 1,
          "title": "Max Workers",
          "type": "integer"
        },
        "note": {
          "default": "one run per declared clean or attack variant per repetition; the count is fixed before any result is seen",
          "title": "Note",
          "type": "string"
        },
        "repetitions": {
          "default": 1,
          "title": "Repetitions",
          "type": "integer"
        }
      },
      "title": "PlanBudget",
      "type": "object"
    },
    "PlanGeneration": {
      "additionalProperties": false,
      "properties": {
        "candidate_budget": {
          "default": 3,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "require_candidate_validation": {
          "default": true,
          "title": "Require Candidate Validation",
          "type": "boolean"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "tier_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/PlanTierProfile"
          },
          "title": "Tier Profiles",
          "type": "object"
        }
      },
      "title": "PlanGeneration",
      "type": "object"
    },
    "PlanInvariants": {
      "additionalProperties": false,
      "description": "Run conditions that are **not** experimental variables.",
      "properties": {
        "egress_probe": {
          "default": "always_on",
          "title": "Egress Probe",
          "type": "string"
        },
        "fresh_state": {
          "default": "always_on",
          "title": "Fresh State",
          "type": "string"
        },
        "history_absent": {
          "default": "always_on",
          "title": "History Absent",
          "type": "string"
        },
        "note": {
          "default": "these are enforced for the clean baseline and every injected variant; a run that does not satisfy them is ineligible, it is not an attack outcome",
          "title": "Note",
          "type": "string"
        },
        "oracle_isolation": {
          "default": "always_on",
          "title": "Oracle Isolation",
          "type": "string"
        },
        "scoring": {
          "default": "after the run, in the verifier process",
          "title": "Scoring",
          "type": "string"
        },
        "task_prompt": {
          "default": "identical across every variant of a task",
          "title": "Task Prompt",
          "type": "string"
        },
        "workspace_containment": {
          "default": "always_on",
          "title": "Workspace Containment",
          "type": "string"
        }
      },
      "title": "PlanInvariants",
      "type": "object"
    },
    "PlanRunCell": {
      "additionalProperties": false,
      "description": "One pre-randomized audit cell in the order it must execute.",
      "properties": {
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "order",
        "repetition",
        "variant_id"
      ],
      "title": "PlanRunCell",
      "type": "object"
    },
    "PlanTarget": {
      "additionalProperties": false,
      "description": "Opaque target identity frozen without publishing the oracle target id.",
      "properties": {
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "target_ref",
        "ordinal"
      ],
      "title": "PlanTarget",
      "type": "object"
    },
    "PlanTask": {
      "additionalProperties": false,
      "properties": {
        "archive_source_id": {
          "title": "Archive Source Id",
          "type": "string"
        },
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "effective_prompt_sha256": {
          "title": "Effective Prompt Sha256",
          "type": "string"
        },
        "eligible_target_count": {
          "default": 0,
          "title": "Eligible Target Count",
          "type": "integer"
        },
        "primary_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Language"
        },
        "repetitions": {
          "default": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "repo_id": {
          "title": "Repo Id",
          "type": "string"
        },
        "repo_url": {
          "title": "Repo Url",
          "type": "string"
        },
        "run_order": {
          "items": {
            "$ref": "#/$defs/PlanRunCell"
          },
          "title": "Run Order",
          "type": "array"
        },
        "selected_target_count": {
          "default": 0,
          "title": "Selected Target Count",
          "type": "integer"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_prompt_sha256": {
          "title": "Source Prompt Sha256",
          "type": "string"
        },
        "target_count": {
          "default": 0,
          "title": "Target Count",
          "type": "integer"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/PlanTarget"
          },
          "title": "Targets",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "task_prompt_rule_version": {
          "title": "Task Prompt Rule Version",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/PlanVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "snapshot_id",
        "repo_id",
        "repo_url",
        "commit_sha",
        "archive_source_id",
        "source_prompt_sha256",
        "effective_prompt_sha256",
        "task_prompt_rule_version"
      ],
      "title": "PlanTask",
      "type": "object"
    },
    "PlanTierProfile": {
      "additionalProperties": false,
      "description": "The generation rules a tier is frozen with (design §5.1).",
      "properties": {
        "candidate_budget": {
          "default": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "generator_profile": {
          "default": "default",
          "title": "Generator Profile",
          "type": "string"
        },
        "max_files_changed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Files Changed"
        },
        "max_inserted_lines": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Inserted Lines"
        },
        "max_model_calls": {
          "default": 0,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_payload_chars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Payload Chars"
        },
        "selection_policy": {
          "default": "semantic_fit_then_deterministic_tiebreak",
          "title": "Selection Policy",
          "type": "string"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier"
      ],
      "title": "PlanTierProfile",
      "type": "object"
    },
    "PlanVariant": {
      "additionalProperties": false,
      "properties": {
        "base_variant_id": {
          "default": "",
          "title": "Base Variant Id",
          "type": "string"
        },
        "candidate_budget": {
          "default": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "carrier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carrier"
        },
        "condition_id": {
          "default": "",
          "title": "Condition Id",
          "type": "string"
        },
        "dose": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose"
        },
        "edit_count": {
          "default": 0,
          "title": "Edit Count",
          "type": "integer"
        },
        "edit_paths": {
          "items": {
            "type": "string"
          },
          "title": "Edit Paths",
          "type": "array"
        },
        "generator_profile": {
          "default": "default",
          "title": "Generator Profile",
          "type": "string"
        },
        "generator_tier": {
          "default": "T0",
          "title": "Generator Tier",
          "type": "string"
        },
        "intensity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "method_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Id"
        },
        "objective": {
          "default": "none",
          "title": "Objective",
          "type": "string"
        },
        "primary_mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Mechanism"
        },
        "realization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realization Id"
        },
        "reproduction_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reproduction Status"
        },
        "selection_policy": {
          "default": "semantic_fit_then_deterministic_tiebreak",
          "title": "Selection Policy",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "surface": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "taxonomy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy Version"
        },
        "threat_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threat Model Id"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "kind"
      ],
      "title": "PlanVariant",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_root": {
      "title": "Archive Root",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/PlanBudget"
    },
    "config_sha256": {
      "title": "Config Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Manifest Sha256"
    },
    "dataset_root": {
      "title": "Dataset Root",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/PlanGeneration"
    },
    "invariants": {
      "$ref": "#/$defs/PlanInvariants"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "oracle_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Oracle File"
    },
    "payload_assets_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Payload Assets Sha256",
      "type": "object"
    },
    "primary_objective": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Objective"
    },
    "research_question": {
      "default": "",
      "title": "Research Question",
      "type": "string"
    },
    "schema_version": {
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_prompt_rule_version": {
      "default": "2026-11-03.1",
      "title": "Task Prompt Rule Version",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/PlanTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "tasks_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tasks File"
    },
    "taxonomy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taxonomy Version"
    },
    "threat_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threat Model Id"
    },
    "variant_set_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant Set File"
    },
    "variant_set_id": {
      "default": "inline",
      "title": "Variant Set Id",
      "type": "string"
    },
    "variant_set_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant Set Sha256"
    }
  },
  "required": [
    "config_sha256",
    "dataset_root",
    "archive_root"
  ],
  "title": "PlanDoc",
  "type": "object"
}
