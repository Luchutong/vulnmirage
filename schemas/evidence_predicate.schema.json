{
  "$defs": {
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Sha256"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "PredicateType": {
      "enum": [
        "read_location",
        "search_symbol",
        "trace_call_edge",
        "permission_check",
        "sanitizer_effect",
        "critical_operation",
        "execute_poc",
        "run_test",
        "run_validator",
        "false_bridge_check",
        "safe_target_check"
      ],
      "title": "PredicateType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One atom of a verification requirement.\n\nReading a location is never by itself decisive: a claim such as\n\"unreachable\" or \"already sanitized\" can only be refuted by checking the\nentry point, the call edges and the operation, or by executing a validator.",
  "properties": {
    "argv": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Argv"
    },
    "decisive": {
      "default": false,
      "title": "Decisive",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "expected_exit_codes": {
      "items": {
        "type": "integer"
      },
      "title": "Expected Exit Codes",
      "type": "array"
    },
    "min_distinct_locations": {
      "default": 1,
      "minimum": 1,
      "title": "Min Distinct Locations",
      "type": "integer"
    },
    "must_occur_after_exposure": {
      "default": false,
      "title": "Must Occur After Exposure",
      "type": "boolean"
    },
    "predicate_id": {
      "title": "Predicate Id",
      "type": "string"
    },
    "predicate_type": {
      "$ref": "#/$defs/PredicateType"
    },
    "required_symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Symbol"
    },
    "target_locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Target Locations",
      "type": "array"
    }
  },
  "required": [
    "predicate_id",
    "predicate_type",
    "description"
  ],
  "title": "EvidencePredicate",
  "type": "object"
}
