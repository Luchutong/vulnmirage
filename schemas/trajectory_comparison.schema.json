        },
        "repetition": {
          "default": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "report_present": {
          "default": false,
          "title": "Report Present",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "target_files_touched": {
          "items": {
            "type": "string"
          },
          "title": "Target Files Touched",
          "type": "array"
