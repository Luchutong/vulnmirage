{
  "$defs": {
    "ContextBudget": {
      "additionalProperties": false,
      "description": "Explicit context budget; truncation is recorded, never hidden.",
      "properties": {
        "max_chars": {
          "default": 12000,
          "minimum": 256,
          "title": "Max Chars",
          "type": "integer"
        },
        "max_files": {
          "default": 8,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_snippets": {
          "default": 24,
          "minimum": 1,
          "title": "Max Snippets",
          "type": "integer"
        },
        "max_style_samples": {
          "default": 4,
          "minimum": 0,
          "title": "Max Style Samples",
          "type": "integer"
        }
      },
      "title": "ContextBudget",
      "type": "object"
    },
    "ContextUsage": {
      "additionalProperties": false,
      "properties": {
        "chars": {
          "default": 0,
          "title": "Chars",
          "type": "integer"
        },
        "files": {
          "default": 0,
          "title": "Files",
          "type": "integer"
        },
        "omitted_files": {
          "items": {
            "type": "string"
          },
          "title": "Omitted Files",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "snippets": {
          "default": 0,
          "title": "Snippets",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "title": "ContextUsage",
      "type": "object"
    },
    "DocumentationStyle": {
      "additionalProperties": false,
      "description": "Observed documentation conventions of the snapshot (not a guess).",
      "properties": {
        "comment_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment Prefix"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "heading_levels": {
          "items": {
            "type": "string"
          },
          "title": "Heading Levels",
          "type": "array"
        },
        "mean_paragraph_chars": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Paragraph Chars"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/FactEvidence"
          },
          "title": "Samples",
          "type": "array"
        },
        "suffixes": {
          "items": {
            "type": "string"
          },
          "title": "Suffixes",
          "type": "array"
        },
        "terminology": {
          "items": {
            "type": "string"
          },
          "title": "Terminology",
          "type": "array"
        }
      },
      "title": "DocumentationStyle",
      "type": "object"
    },
    "FactEvidence": {
      "additionalProperties": false,
      "description": "Traceable evidence for one fact.",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "snippet_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet Sha256"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "FactEvidence",
      "type": "object"
    },
    "FactKind": {
      "description": "What a repository fact states.",
      "enum": [
        "target_entry_point",
        "target_critical_operation",
        "target_trace",
        "symbol",
        "call_site",
        "protection",
        "route",
        "config_default",
        "test",
        "documentation",
        "documentation_style",
        "related_file"
      ],
      "title": "FactKind",
      "type": "string"
    },
    "FactMethod": {
      "description": "How the fact was established (recorded so it can be audited).",
      "enum": [
        "python_ast",
        "text_pattern",
        "file_scan",
        "import_graph",
        "documentation_scan",
        "manual"
      ],
      "title": "FactMethod",
      "type": "string"
    },
    "FactStatus": {
      "description": "Trust status of a fact.\n\n``verified`` means a concrete extraction method produced it from this\nsnapshot.  ``candidate`` means the method found a plausible but unresolved\nmatch (for example a same-name call in another module).  ``unknown`` means\nthe property could not be decided; it is never upgraded to a pass.",
      "enum": [
        "verified",
        "candidate",
        "unknown",
        "unsupported"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "RepositoryFact": {
      "additionalProperties": false,
      "description": "One verified/candidate/unknown statement about the fixed snapshot.",
      "properties": {
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/FactEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FactKind"
        },
        "method": {
          "$ref": "#/$defs/FactMethod"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FactStatus",
          "default": "verified"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "statement",
        "method"
      ],
      "title": "RepositoryFact",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "All facts extracted for one target, plus extraction capabilities.",
  "properties": {
    "budget": {
      "$ref": "#/$defs/ContextBudget"
    },
    "documentation_style": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentationStyle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/RepositoryFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "language_capability": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Language Capability",
      "type": "object"
    },
    "missing": {
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "repository_tree_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Tree Sha256"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "target_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target File"
    },
    "target_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Handle"
    },
    "target_safe_target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Safe Target Id"
    },
    "target_vulnerability_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Vulnerability Id"
    },
    "usage": {
      "$ref": "#/$defs/ContextUsage"
    }
  },
  "title": "RepositoryFacts",
  "type": "object"
}
