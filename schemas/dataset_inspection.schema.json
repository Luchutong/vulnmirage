{
  "$defs": {
    "DatasetCapabilities": {
      "additionalProperties": false,
      "description": "What a dataset can support, derived from its records.",
      "properties": {
        "dataset_name": {
          "title": "Dataset Name",
          "type": "string"
        },
        "has_adjudicated_severity": {
          "default": false,
          "title": "Has Adjudicated Severity",
          "type": "boolean"
        },
        "has_attack_plans": {
          "default": false,
          "title": "Has Attack Plans",
          "type": "boolean"
        },
        "has_fix_commits": {
          "default": false,
          "title": "Has Fix Commits",
          "type": "boolean"
        },
        "has_poc_commands": {
          "default": false,
          "title": "Has Poc Commands",
          "type": "boolean"
        },
        "has_regression_commands": {
          "default": false,
          "title": "Has Regression Commands",
          "type": "boolean"
        },
        "has_safe_targets": {
          "default": false,
          "title": "Has Safe Targets",
          "type": "boolean"
        },
        "has_severity": {
          "default": false,
          "title": "Has Severity",
          "type": "boolean"
        },
        "has_split_groups": {
          "default": false,
          "title": "Has Split Groups",
          "type": "boolean"
        },
        "has_validated_safe_targets": {
          "default": false,
          "title": "Has Validated Safe Targets",
          "type": "boolean"
        },
        "has_validation_level": {
          "default": false,
          "title": "Has Validation Level",
          "type": "boolean"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "supported_goals": {
          "items": {
            "type": "string"
          },
          "title": "Supported Goals",
          "type": "array"
        }
      },
      "required": [
        "dataset_name"
      ],
      "title": "DatasetCapabilities",
      "type": "object"
    },
    "DatasetIssue": {
      "additionalProperties": false,
      "description": "A structured import issue (never a bare string).",
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "DatasetIssue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/DatasetCapabilities"
    },
    "case_count": {
      "default": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "cases_path": {
      "title": "Cases Path",
      "type": "string"
    },
    "dataset_name": {
      "title": "Dataset Name",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/DatasetIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "manifest_path": {
      "title": "Manifest Path",
      "type": "string"
    },
    "repository_count": {
      "default": 0,
      "title": "Repository Count",
      "type": "integer"
    },
    "sample_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Sample Case Ids",
      "type": "array"
    },
    "split_group_count": {
      "default": 0,
      "title": "Split Group Count",
      "type": "integer"
    }
  },
  "required": [
    "dataset_name",
    "manifest_path",
    "cases_path",
    "capabilities"
  ],
  "title": "DatasetInspection",
  "type": "object"
}
