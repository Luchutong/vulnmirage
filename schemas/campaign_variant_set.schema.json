{
  "$defs": {
    "VariantEditConfig": {
      "additionalProperties": false,
      "properties": {
        "find": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Find"
        },
        "op": {
          "default": "create",
          "enum": [
            "create",
            "append",
            "insert_before"
          ],
          "title": "Op",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "VariantEditConfig",
      "type": "object"
    },
    "VariantSpecConfig": {
      "additionalProperties": false,
      "properties": {
        "carrier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carrier"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/VariantEditConfig"
          },
          "title": "Edits",
          "type": "array"
        },
        "forbidden_tokens": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Tokens",
          "type": "array"
        },
        "generator_tier": {
          "default": "T0",
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4"
          ],
          "title": "Generator Tier",
          "type": "string"
        },
        "kind": {
          "default": "attack",
          "enum": [
            "clean",
            "attack"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Id"
        },
        "objective": {
          "default": "none",
          "enum": [
            "O-FN",
            "O-FP",
            "O-SEV-D",
            "O-SEV-I",
            "O-EV",
            "O-SCOPE",
            "O-AVAIL",
            "none"
          ],
          "title": "Objective",
          "type": "string"
        },
        "realization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realization Id"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id"
      ],
      "title": "VariantSpecConfig",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One pre-registered group of conditions for a single research question.",
  "properties": {
    "primary_objective": {
      "pattern": "^O-(FN|FP|SEV-D|SEV-I|EV|SCOPE|AVAIL)$",
      "title": "Primary Objective",
      "type": "string"
    },
    "research_question": {
      "minLength": 1,
      "title": "Research Question",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "taxonomy_version": {
      "const": "vm-atk-1.0",
      "default": "vm-atk-1.0",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "threat_model_id": {
      "minLength": 1,
      "title": "Threat Model Id",
      "type": "string"
    },
    "variant_set_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Variant Set Id",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/VariantSpecConfig"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "threat_model_id",
    "primary_objective",
    "variant_set_id",
    "research_question",
    "variants"
  ],
  "title": "VariantSetDefinition",
  "type": "object"
}
