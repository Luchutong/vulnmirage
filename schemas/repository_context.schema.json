{
  "$defs": {
    "AttackGoal": {
      "enum": [
        "false_negative",
        "false_positive",
        "severity_inflation",
        "severity_downgrade",
        "evidence_corruption",
        "verification_diversion"
      ],
      "title": "AttackGoal",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Sha256"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "CodeLocation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The *minimal* repository view that may be shown to a generation model.\n\nIt deliberately excludes the hidden oracle, PoC commands, validator\ncommands, the audit prompt and any test-set feedback.",
  "properties": {
    "allowed_paths": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Paths",
      "type": "array"
    },
    "attack_goal": {
      "$ref": "#/$defs/AttackGoal"
    },
    "behavior_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Behavior Constraints",
      "type": "array"
    },
    "callers": {
      "items": {
        "type": "string"
      },
      "title": "Callers",
      "type": "array"
    },
    "cwe": {
      "items": {
        "type": "string"
      },
      "title": "Cwe",
      "type": "array"
    },
    "documentation_style": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documentation Style"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "local_code_snippets": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Local Code Snippets",
      "type": "array"
    },
    "project_name": {
      "title": "Project Name",
      "type": "string"
    },
    "target_component": {
      "title": "Target Component",
      "type": "string"
    },
    "visible_functions": {
      "items": {
        "type": "string"
      },
      "title": "Visible Functions",
      "type": "array"
    }
  },
  "required": [
    "project_name",
    "target_component",
    "attack_goal"
  ],
  "title": "RepositoryContext",
  "type": "object"
}
