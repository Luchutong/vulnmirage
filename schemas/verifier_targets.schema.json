{
  "$defs": {
    "EvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "acceptable_locations": {
          "items": {
            "$ref": "#/$defs/RubricLocation"
          },
          "title": "Acceptable Locations",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Kinds",
          "type": "array"
        },
        "minimum_citations": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Citations",
          "type": "integer"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "EvidenceRequirement",
      "type": "object"
    },
    "PrivateTarget": {
      "additionalProperties": false,
      "description": "One scored target, reduced to what scoring needs.",
      "properties": {
        "cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "eligibility": {
          "default": "snapshot_verified",
          "title": "Eligibility",
          "type": "string"
        },
        "entry_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry File"
        },
        "entry_function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Function"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Function"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "oracle_guided": {
          "default": false,
          "title": "Oracle Guided",
          "type": "boolean"
        },
        "severity_convention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Convention"
        },
        "severity_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Level"
        },
        "severity_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Score"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "file"
      ],
      "title": "PrivateTarget",
      "type": "object"
    },
    "RubricLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        }
      },
      "required": [
        "file"
      ],
      "title": "RubricLocation",
      "type": "object"
    },
    "SafeDecoy": {
      "additionalProperties": false,
      "description": "A privately certified, intentionally non-vulnerable injected location.\n\nOnly findings that match one of these explicit locations may be called an\ninduced false positive.  Findings elsewhere remain unadjudicated because the\nbenchmark oracle is not an exhaustive inventory of every repository flaw.",
      "properties": {
        "cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "decoy_id": {
          "title": "Decoy Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "proof_kind": {
          "title": "Proof Kind",
          "type": "string"
        },
        "proof_sha256": {
          "title": "Proof Sha256",
          "type": "string"
        },
        "safety_basis": {
          "title": "Safety Basis",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "decoy_id",
        "variant_id",
        "file",
        "proof_kind",
        "proof_sha256",
        "safety_basis"
      ],
      "title": "SafeDecoy",
      "type": "object"
    },
    "TargetRubric": {
      "additionalProperties": false,
      "description": "Frozen private contract for one vulnerability target.",
      "properties": {
        "accepted_descriptions": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Descriptions",
          "type": "array"
        },
        "accepted_severity_interval": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Severity Interval"
        },
        "affected_behavior": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Behavior"
        },
        "attacker_control": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attacker Control"
        },
        "critical_operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Critical Operation"
        },
        "cwe_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cwe Ids",
          "type": "array"
        },
        "dangerous_effect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dangerous Effect"
        },
        "excluded_off_target_claims": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Off Target Claims",
          "type": "array"
        },
        "expected_severity_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Severity Level"
        },
        "expected_severity_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Severity Score"
        },
        "expected_verdict": {
          "default": "report",
          "enum": [
            "report",
            "do_not_report"
          ],
          "title": "Expected Verdict",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRequirement"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "required_preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Required Preconditions",
          "type": "array"
        },
        "root_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "default": "dataset-core",
          "title": "Source",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "TargetRubric",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "built_at": {
      "title": "Built At",
      "type": "string"
    },
    "rubrics": {
      "items": {
        "$ref": "#/$defs/TargetRubric"
      },
      "title": "Rubrics",
      "type": "array"
    },
    "safe_decoys": {
      "items": {
        "$ref": "#/$defs/SafeDecoy"
      },
      "title": "Safe Decoys",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "default": "dataset-core",
      "title": "Source",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/PrivateTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "snapshot_id"
  ],
  "title": "TargetSet",
  "type": "object"
}
