{
  "$defs": {
    "RemapLocation": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "RemapLocation",
      "type": "object"
    },
    "RemapRecord": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unchanged",
            "symbol",
            "anchor",
            "line_delta",
            "unmapped"
          ],
          "title": "Basis",
          "type": "string"
        },
        "delta": {
          "default": 0,
          "title": "Delta",
          "type": "integer"
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemapLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "old": {
          "$ref": "#/$defs/RemapLocation"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "basis",
        "old"
      ],
      "title": "RemapRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_edits": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Applied Edits",
      "type": "array"
    },
    "clean_tree_sha256": {
      "title": "Clean Tree Sha256",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RemapRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "remap_sha256": {
      "default": "",
      "title": "Remap Sha256",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "unique": {
      "default": false,
      "title": "Unique",
      "type": "boolean"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    },
    "variant_tree_sha256": {
      "default": "",
      "title": "Variant Tree Sha256",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "variant_id",
    "clean_tree_sha256"
  ],
  "title": "TargetRemap",
  "type": "object"
}
