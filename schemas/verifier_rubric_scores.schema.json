{
  "$defs": {
    "ComponentScore": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "ComponentScore",
      "type": "object"
    },
    "TargetRubricScore": {
      "additionalProperties": false,
      "properties": {
        "attributable": {
          "$ref": "#/$defs/ComponentScore"
        },
        "evidence_validation": {
          "$ref": "#/$defs/ComponentScore"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "identification": {
          "$ref": "#/$defs/ComponentScore"
        },
        "severity": {
          "$ref": "#/$defs/ComponentScore"
        },
        "severity_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Delta"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ComponentScore"
        }
      },
      "required": [
        "target_id",
        "verdict",
        "identification",
        "evidence_validation",
        "severity",
        "attributable"
      ],
      "title": "TargetRubricScore",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/TargetRubricScore"
      },
      "title": "Scores",
      "type": "array"
    },
    "status": {
      "default": "unknown",
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Summary",
      "type": "object"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    }
  },
  "title": "RubricScoreReport",
  "type": "object"
}
