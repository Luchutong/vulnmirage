{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Bytes"
    },
    "archive_reused_from_cache": {
      "default": false,
      "title": "Archive Reused From Cache",
      "type": "boolean"
    },
    "archive_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Sha256"
    },
    "commit": {
      "title": "Commit",
      "type": "string"
    },
    "downloaded_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Downloaded At"
    },
    "extracted_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extracted At"
    },
    "file_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Count"
    },
    "final_url": {
      "title": "Final Url",
      "type": "string"
    },
    "history_metadata": {
      "items": {
        "type": "string"
      },
      "title": "History Metadata",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "redirect_chain": {
      "items": {
        "type": "string"
      },
      "title": "Redirect Chain",
      "type": "array"
    },
    "rejected_entries": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Rejected Entries",
      "type": "array"
    },
    "requested_url": {
      "title": "Requested Url",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "strip_prefix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strip Prefix"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "total_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Bytes"
    },
    "tree_digest_source": {
      "default": "unpacked-archive",
      "title": "Tree Digest Source",
      "type": "string"
    },
    "tree_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tree Sha256"
    }
  },
  "required": [
    "task_id",
    "snapshot_id",
    "provider",
    "source_id",
    "commit",
    "requested_url",
    "final_url"
  ],
  "title": "SourceManifest",
  "type": "object"
}
