{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "adapter_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adapter Version"
    },
    "invalid_lines": {
      "default": 0,
      "title": "Invalid Lines",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "output_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Output Sha256",
      "type": "object"
    },
    "parsed_events": {
      "default": 0,
      "title": "Parsed Events",
      "type": "integer"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source File"
    },
    "source_lines": {
      "default": 0,
      "title": "Source Lines",
      "type": "integer"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "missing",
        "empty",
        "unsupported",
        "disabled"
      ],
      "title": "Status",
      "type": "string"
    },
    "unknown_event_types": {
      "items": {
        "type": "string"
      },
      "title": "Unknown Event Types",
      "type": "array"
    }
  },
  "required": [
    "adapter",
    "status"
  ],
  "title": "TraceManifest",
  "type": "object"
}
