{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "control_chars_removed": {
      "default": 0,
      "title": "Control Chars Removed",
      "type": "integer"
    },
    "fence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fence"
    },
    "original_chars": {
      "title": "Original Chars",
      "type": "integer"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "served_chars": {
      "title": "Served Chars",
      "type": "integer"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "sha256",
    "original_chars",
    "served_chars"
  ],
  "title": "UntrustedInput",
  "type": "object"
}
