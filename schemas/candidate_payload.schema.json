{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A rendered, structured edit before it is applied to a tree.",
  "properties": {
    "anchor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "carrier": {
      "title": "Carrier",
      "type": "string"
    },
    "content_sha256": {
      "default": "",
      "title": "Content Sha256",
      "type": "string"
    },
    "context_fields_used": {
      "items": {
        "type": "string"
      },
      "title": "Context Fields Used",
      "type": "array"
    },
    "dose": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dose"
    },
    "edit_op": {
      "default": "create",
      "enum": [
        "create",
        "append",
        "insert_before"
      ],
      "title": "Edit Op",
      "type": "string"
    },
    "estimated_files": {
      "default": 1,
      "title": "Estimated Files",
      "type": "integer"
    },
    "estimated_lines": {
      "default": 1,
      "title": "Estimated Lines",
      "type": "integer"
    },
    "estimated_tokens": {
      "default": 0,
      "title": "Estimated Tokens",
      "type": "integer"
    },
    "generator": {
      "title": "Generator",
      "type": "string"
    },
    "generator_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "title": "Generator Tier",
      "type": "string"
    },
    "intensity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intensity"
    },
    "method_id": {
      "title": "Method Id",
      "type": "string"
    },
    "objective": {
      "default": "none",
      "title": "Objective",
      "type": "string"
    },
    "placement_basis": {
      "default": "template",
      "title": "Placement Basis",
      "type": "string"
    },
    "primary_mechanism": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Mechanism"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provenance",
      "type": "object"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "realization_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realization Id"
    },
    "rendered_text": {
      "title": "Rendered Text",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "surface": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surface"
    },
    "target_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target File"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "variant_id",
    "method_id",
    "generator_tier",
    "generator",
    "carrier",
    "rendered_text"
  ],
  "title": "CandidatePayload",
  "type": "object"
}
