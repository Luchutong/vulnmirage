{
  "$defs": {
    "AttackSurface": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "enum": [
            "S-DOC",
            "S-RULE",
            "S-COMMENT",
            "S-CODE",
            "S-CONFIG",
            "S-TEST",
            "S-META",
            "S-GENERATED",
            "S-TOOL"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "zone": {
          "enum": [
            "Z-AUTO",
            "Z-ROOT",
            "Z-TARGET",
            "Z-ENTRY",
            "Z-SINK",
            "Z-PATH",
            "Z-PERIPHERAL"
          ],
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "zone"
      ],
      "title": "AttackSurface",
      "type": "object"
    },
    "CausalHypothesis": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "title": "Alternative Explanations",
          "type": "array"
        },
        "behavior": {
          "minLength": 1,
          "title": "Behavior",
          "type": "string"
        },
        "exposure": {
          "minLength": 1,
          "title": "Exposure",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "uptake": {
          "minLength": 1,
          "title": "Uptake",
          "type": "string"
        }
      },
      "required": [
        "exposure",
        "uptake",
        "behavior",
        "outcome"
      ],
      "title": "CausalHypothesis",
      "type": "object"
    },
    "EvaluationContract": {
      "additionalProperties": false,
      "properties": {
        "intermediate_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Intermediate Metrics",
          "type": "array"
        },
        "primary_metric": {
          "minLength": 1,
          "title": "Primary Metric",
          "type": "string"
        }
      },
      "required": [
        "primary_metric"
      ],
      "title": "EvaluationContract",
      "type": "object"
    },
    "IntensityProfile": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_claims": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Claims",
          "type": "integer"
        },
        "max_supporting_evidence": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Max Supporting Evidence",
          "type": "integer"
        }
      },
      "required": [
        "description"
      ],
      "title": "IntensityProfile",
      "type": "object"
    },
    "MechanismSpec": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ],
          "title": "Class",
          "type": "string"
        },
        "modifiers": {
          "items": {
            "type": "string"
          },
          "title": "Modifiers",
          "type": "array"
        },
        "primary": {
          "title": "Primary",
          "type": "string"
        }
      },
      "required": [
        "class",
        "primary"
      ],
      "title": "MechanismSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causal_hypothesis": {
      "$ref": "#/$defs/CausalHypothesis"
    },
    "evaluation_contract": {
      "$ref": "#/$defs/EvaluationContract"
    },
    "intensity_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/IntensityProfile"
      },
      "propertyNames": {
        "enum": [
          "I0",
          "I1",
          "I2",
          "I3",
          "I4"
        ]
      },
      "title": "Intensity Profiles",
      "type": "object"
    },
    "mechanism": {
      "$ref": "#/$defs/MechanismSpec"
    },
    "method_id": {
      "minLength": 1,
      "title": "Method Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "source_urls": {
      "items": {
        "type": "string"
      },
      "title": "Source Urls",
      "type": "array"
    },
    "supported_objectives": {
      "items": {
        "enum": [
          "O-FN",
          "O-FP",
          "O-SEV-D",
          "O-SEV-I",
          "O-EV",
          "O-SCOPE",
          "O-AVAIL"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Objectives",
      "type": "array"
    },
    "supported_surfaces": {
      "items": {
        "$ref": "#/$defs/AttackSurface"
      },
      "minItems": 1,
      "title": "Supported Surfaces",
      "type": "array"
    },
    "taxonomy_version": {
      "default": "vm-atk-1.0",
      "title": "Taxonomy Version",
      "type": "string"
    }
  },
  "required": [
    "method_id",
    "name",
    "mechanism",
    "supported_objectives",
    "causal_hypothesis",
    "supported_surfaces",
    "intensity_profiles",
    "evaluation_contract"
  ],
  "title": "AttackMethod",
  "type": "object"
}
