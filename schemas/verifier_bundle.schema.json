{
  "$defs": {
    "BundleEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "name",
        "present"
      ],
      "title": "BundleEntry",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/BundleEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "frozen_at": {
      "title": "Frozen At",
      "type": "string"
    },
    "producer": {
      "default": "harness",
      "title": "Producer",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "task_id",
    "run_id",
    "variant_id"
  ],
  "title": "BundleManifest",
  "type": "object"
}
