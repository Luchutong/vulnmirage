{
  "$defs": {
    "AgentFinding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "critical_operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "entry_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "title": "Evidence Citations",
          "type": "array"
        },
        "exploitability": {
          "title": "Exploitability",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Locations",
          "type": "array"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "severity": {
          "$ref": "#/$defs/SeverityLevel"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Trace",
          "type": "array"
        },
        "vulnerability_type": {
          "title": "Vulnerability Type",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "title",
        "vulnerability_type",
        "severity",
        "locations",
        "exploitability"
      ],
      "title": "AgentFinding",
      "type": "object"
    },
    "AuditSummary": {
      "additionalProperties": false,
      "properties": {
        "files_reviewed": {
          "items": {
            "type": "string"
          },
          "title": "Files Reviewed",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "overall_confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall Confidence",
          "type": "number"
        }
      },
      "title": "AuditSummary",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Sha256"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "A verifiable evidence claim supplied by the agent report.",
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence_kind": {
          "title": "Evidence Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/CodeLocation"
        }
      },
      "required": [
        "citation_id",
        "claim",
        "location",
        "evidence_kind"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "SeverityLevel": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_summary": {
      "$ref": "#/$defs/AuditSummary"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AgentFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "FindingEnvelope",
  "type": "object"
}
