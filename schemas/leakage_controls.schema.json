{
  "$defs": {
    "ChannelReport": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "title": "Channel Id",
          "type": "string"
        },
        "control": {
          "title": "Control",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "legitimate_material": {
          "default": false,
          "title": "Legitimate Material",
          "type": "boolean"
        },
        "residual_risk": {
          "title": "Residual Risk",
          "type": "string"
        },
        "status": {
          "enum": [
            "controlled",
            "failed",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unexecuted_checks": {
          "items": {
            "type": "string"
          },
          "title": "Unexecuted Checks",
          "type": "array"
        }
      },
      "required": [
        "channel_id",
        "title",
        "status",
        "control",
        "residual_risk"
      ],
      "title": "ChannelReport",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelReport"
      },
      "title": "Channels",
      "type": "array"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    }
  },
  "required": [
    "scope"
  ],
  "title": "LeakageControlReport",
  "type": "object"
}
