{
  "$defs": {
    "AttestationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "detail"
      ],
      "title": "AttestationCheck",
      "type": "object"
    },
    "EgressProbeResult": {
      "additionalProperties": false,
      "properties": {
        "blocked_targets": {
          "items": {
            "$ref": "#/$defs/ProbeTarget"
          },
          "title": "Blocked Targets",
          "type": "array"
        },
        "enforcement": {
          "title": "Enforcement",
          "type": "string"
        },
        "gateway_reachable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Reachable"
        },
        "gateway_targets": {
          "items": {
            "$ref": "#/$defs/ProbeTarget"
          },
          "title": "Gateway Targets",
          "type": "array"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "probe_timeout_seconds": {
          "title": "Probe Timeout Seconds",
          "type": "number"
        },
        "probed_at": {
          "title": "Probed At",
          "type": "string"
        },
        "reachable_answer_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Reachable Answer Hosts",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "default": "unknown",
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "enforcement",
        "probe_timeout_seconds"
      ],
      "title": "EgressProbeResult",
      "type": "object"
    },
    "ProbeTarget": {
      "additionalProperties": false,
      "properties": {
        "addresses": {
          "items": {
            "type": "string"
          },
          "title": "Addresses",
          "type": "array"
        },
        "connected": {
          "default": false,
          "title": "Connected",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 443,
          "title": "Port",
          "type": "integer"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "host"
      ],
      "title": "ProbeTarget",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/AttestationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "condition_independent": {
      "default": true,
      "title": "Condition Independent",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "egress": {
      "anyOf": [
        {
          "$ref": "#/$defs/EgressProbeResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "eligibility": {
      "default": "ineligible_unattested",
      "title": "Eligibility",
      "type": "string"
    },
    "failed": {
      "items": {
        "type": "string"
      },
      "title": "Failed",
      "type": "array"
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "title": "Invariants",
      "type": "array"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "unknown": {
      "items": {
        "type": "string"
      },
      "title": "Unknown",
      "type": "array"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    },
    "variant_kind": {
      "title": "Variant Kind",
      "type": "string"
    },
    "verdict": {
      "default": "fail",
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "variant_id",
    "variant_kind",
    "mode"
  ],
  "title": "IsolationAttestation",
  "type": "object"
}
