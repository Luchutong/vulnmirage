{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Report-to-findings correspondence for one run.\n\nOnly unambiguous relations are asserted: which ``finding_id`` the JSON\ncontains, which ids the report mentions, and whether the report exists at all.\nContradictions in *content* are left to adjudication rather than guessed from\ntext similarity.",
  "properties": {
    "consistent": {
      "default": false,
      "title": "Consistent",
      "type": "boolean"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "findings_missing_from_report": {
      "items": {
        "type": "string"
      },
      "title": "Findings Missing From Report",
      "type": "array"
    },
    "ids_in_report": {
      "items": {
        "type": "string"
      },
      "title": "Ids In Report",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "output_contract": {
      "default": "findings_only",
      "title": "Output Contract",
      "type": "string"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "raw_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Sha256"
    },
    "report_chars": {
      "default": 0,
      "title": "Report Chars",
      "type": "integer"
    },
    "report_ids_missing_from_findings": {
      "items": {
        "type": "string"
      },
      "title": "Report Ids Missing From Findings",
      "type": "array"
    },
    "report_present": {
      "default": false,
      "title": "Report Present",
      "type": "boolean"
    },
    "report_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Sha256"
    },
    "report_truncated": {
      "default": false,
      "title": "Report Truncated",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "unknown",
      "title": "Status",
      "type": "string"
    }
  },
  "title": "OutputConsistency",
  "type": "object"
}
