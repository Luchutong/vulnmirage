{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_variant_id": {
      "default": "",
      "title": "Base Variant Id",
      "type": "string"
    },
    "candidate_budget": {
      "default": 1,
      "title": "Candidate Budget",
      "type": "integer"
    },
    "carrier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carrier"
    },
    "condition_id": {
      "default": "",
      "title": "Condition Id",
      "type": "string"
    },
    "dose": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dose"
    },
    "edit_count": {
      "default": 0,
      "title": "Edit Count",
      "type": "integer"
    },
    "edit_paths": {
      "items": {
        "type": "string"
      },
      "title": "Edit Paths",
      "type": "array"
    },
    "generator_profile": {
      "default": "default",
      "title": "Generator Profile",
      "type": "string"
    },
    "generator_tier": {
      "default": "T0",
      "title": "Generator Tier",
      "type": "string"
    },
    "intensity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intensity"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Id"
    },
    "objective": {
      "default": "none",
      "title": "Objective",
      "type": "string"
    },
    "primary_mechanism": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Mechanism"
    },
    "realization_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realization Id"
    },
    "reproduction_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproduction Status"
    },
    "selection_policy": {
      "default": "semantic_fit_then_deterministic_tiebreak",
      "title": "Selection Policy",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "surface": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surface"
    },
    "target_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    },
    "taxonomy_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taxonomy Version"
    },
    "threat_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threat Model Id"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "variant_id",
    "kind"
  ],
  "title": "PlanVariant",
  "type": "object"
}
