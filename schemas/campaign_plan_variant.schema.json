{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_variant_id": {
      "default": "",
      "title": "Base Variant Id",
      "type": "string"
    },
    "candidate_budget": {
      "default": 1,
      "title": "Candidate Budget",
      "type": "integer"
    },
    "carrier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carrier"
    },
    "condition_id": {
      "default": "",
      "title": "Condition Id",
      "type": "string"
    },
    "edit_count": {
      "default": 0,
      "title": "Edit Count",
      "type": "integer"
    },
    "edit_paths": {
      "items": {
        "type": "string"
      },
      "title": "Edit Paths",
      "type": "array"
    },
    "generator_profile": {
      "default": "default",
      "title": "Generator Profile",
      "type": "string"
    },
    "goal": {
      "default": "none",
      "title": "Goal",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "knowledge": {
      "default": "public_context",
      "title": "Knowledge",
      "type": "string"
    },
    "method_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method Id"
    },
    "payload_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Id"
    },
    "reproduction_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproduction Status"
    },
    "selection_policy": {
      "default": "semantic_fit_then_deterministic_tiebreak",
      "title": "Selection Policy",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "target_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    },
    "tier": {
      "default": "T0",
      "title": "Tier",
      "type": "string"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "variant_id",
    "kind"
  ],
  "title": "PlanVariant",
  "type": "object"
}
