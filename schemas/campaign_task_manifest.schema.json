{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_source_id": {
      "title": "Archive Source Id",
      "type": "string"
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "effective_prompt_chars": {
      "title": "Effective Prompt Chars",
      "type": "integer"
    },
    "effective_prompt_sha256": {
      "title": "Effective Prompt Sha256",
      "type": "string"
    },
    "egress_mode": {
      "default": "none",
      "title": "Egress Mode",
      "type": "string"
    },
    "excluded_targets": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Excluded Targets",
      "type": "array"
    },
    "isolation_mode": {
      "default": "workspace",
      "title": "Isolation Mode",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "removed_tokens_count": {
      "default": 0,
      "title": "Removed Tokens Count",
      "type": "integer"
    },
    "repetitions": {
      "default": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "repo_id": {
      "title": "Repo Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_target_count": {
      "default": 0,
      "title": "Scored Target Count",
      "type": "integer"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_prompt_sha256": {
      "title": "Source Prompt Sha256",
      "type": "string"
    },
    "target_count": {
      "default": 0,
      "title": "Target Count",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_prompt_rule_version": {
      "title": "Task Prompt Rule Version",
      "type": "string"
    },
    "transformations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Transformations",
      "type": "array"
    },
    "variant_set_id": {
      "default": "inline",
      "title": "Variant Set Id",
      "type": "string"
    },
    "variants": {
      "items": {
        "type": "string"
      },
      "title": "Variants",
      "type": "array"
    },
    "verifier_mode": {
      "default": "separate_process",
      "title": "Verifier Mode",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "snapshot_id",
    "repo_id",
    "commit_sha",
    "archive_source_id",
    "task_prompt_rule_version",
    "source_prompt_sha256",
    "effective_prompt_sha256",
    "effective_prompt_chars"
  ],
  "title": "TaskManifest",
  "type": "object"
}
