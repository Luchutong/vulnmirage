{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessed_at": {
      "title": "Assessed At",
      "type": "string"
    },
    "event_count": {
      "default": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "file_access_count": {
      "default": 0,
      "title": "File Access Count",
      "type": "integer"
    },
    "final_text_observed": {
      "default": false,
      "title": "Final Text Observed",
      "type": "boolean"
    },
    "invalid_line_count": {
      "default": 0,
      "title": "Invalid Line Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "unsupported",
        "disabled"
      ],
      "title": "Status",
      "type": "string"
    },
    "terminal_step_observed": {
      "default": false,
      "title": "Terminal Step Observed",
      "type": "boolean"
    },
    "terminal_tool_call_count": {
      "default": 0,
      "title": "Terminal Tool Call Count",
      "type": "integer"
    },
    "tool_call_count": {
      "default": 0,
      "title": "Tool Call Count",
      "type": "integer"
    },
    "tool_terminal_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Terminal Rate"
    },
    "unknown_event_count": {
      "default": 0,
      "title": "Unknown Event Count",
      "type": "integer"
    }
  },
  "required": [
    "status"
  ],
  "title": "TraceCompleteness",
  "type": "object"
}
