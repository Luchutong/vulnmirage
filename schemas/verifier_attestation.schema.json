{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "process": {
      "additionalProperties": true,
      "title": "Process",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verdict": {
      "default": "fail",
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "task_id",
    "run_id",
    "mode"
  ],
  "title": "VerifierAttestation",
  "type": "object"
}
