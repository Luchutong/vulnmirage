{
  "$defs": {
    "AgentFinding": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "critical_operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "entry_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "title": "Evidence Citations",
          "type": "array"
        },
        "exploitability": {
          "title": "Exploitability",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Locations",
          "type": "array"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "severity": {
          "$ref": "#/$defs/SeverityLevel"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Trace",
          "type": "array"
        },
        "vulnerability_type": {
          "title": "Vulnerability Type",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "title",
        "vulnerability_type",
        "severity",
        "locations",
        "exploitability"
      ],
      "title": "AgentFinding",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Sha256"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "A verifiable evidence claim supplied by the agent report.",
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence_kind": {
          "title": "Evidence Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/CodeLocation"
        }
      },
      "required": [
        "citation_id",
        "claim",
        "location",
        "evidence_kind"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "ReferenceBudget": {
      "additionalProperties": false,
      "description": "Acquisition budget.  ``None`` means *unknown*, never zero.",
      "properties": {
        "cost_known": {
          "default": false,
          "title": "Cost Known",
          "type": "boolean"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "max_queries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Queries"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "queries_used": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queries Used"
        },
        "tokens_used": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Used"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Seconds"
        }
      },
      "title": "ReferenceBudget",
      "type": "object"
    },
    "ReferenceSource": {
      "enum": [
        "none",
        "import",
        "run"
      ],
      "title": "ReferenceSource",
      "type": "string"
    },
    "ReferenceStatus": {
      "enum": [
        "ok",
        "format_failure",
        "timeout",
        "failed",
        "unsupported",
        "missing",
        "invalid"
      ],
      "title": "ReferenceStatus",
      "type": "string"
    },
    "ReferenceTraceObservation": {
      "additionalProperties": false,
      "description": "Trajectory-backed observations of R0.\n\nEvery entry cites a real event id.  Without a native trace this object is\n``available=False`` and no visited file/search term is inferred from the\nfinal report text.",
      "properties": {
        "available": {
          "default": false,
          "title": "Available",
          "type": "boolean"
        },
        "commands": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Commands",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "importer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "observability_level": {
          "default": "none",
          "title": "Observability Level",
          "type": "string"
        },
        "read_ranges": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Read Ranges",
          "type": "array"
        },
        "search_terms": {
          "items": {
            "type": "string"
          },
          "title": "Search Terms",
          "type": "array"
        },
        "visited_files": {
          "items": {
            "type": "string"
          },
          "title": "Visited Files",
          "type": "array"
        }
      },
      "title": "ReferenceTraceObservation",
      "type": "object"
    },
    "SeverityLevel": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One R0 acquisition, with an identity independent of any formal run.",
  "properties": {
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ReferenceBudget"
    },
    "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
    },
    "cache_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Key"
    },
    "config_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Sha256"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AgentFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "findings_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Findings Path"
    },
    "imported_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Imported At"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "purpose": {
      "const": "reference",
      "default": "reference",
      "title": "Purpose",
      "type": "string"
    },
    "raw_report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Report Path"
    },
    "raw_report_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Report Sha256"
    },
    "reference_audit_id": {
      "title": "Reference Audit Id",
      "type": "string"
    },
    "repetition": {
      "default": 1,
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "report_access": {
      "default": "target",
      "enum": [
        "none",
        "surrogate",
        "target"
      ],
      "title": "Report Access",
      "type": "string"
    },
    "repository_tree_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Tree Sha256"
    },
    "role": {
      "const": "reference",
      "default": "reference",
      "title": "Role",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "source": {
      "$ref": "#/$defs/ReferenceSource",
      "default": "import"
    },
    "source_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reference"
    },
    "status": {
      "$ref": "#/$defs/ReferenceStatus",
      "default": "ok"
    },
    "task_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Sha256"
    },
    "trace": {
      "$ref": "#/$defs/ReferenceTraceObservation"
    },
    "trace_access": {
      "default": "none",
      "enum": [
        "none",
        "observable"
      ],
      "title": "Trace Access",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "reference_audit_id",
    "agent",
    "session_id"
  ],
  "title": "ReferenceAudit",
  "type": "object"
}
