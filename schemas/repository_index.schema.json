{
  "$defs": {
    "IndexedFile": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "default": false,
          "title": "Binary",
          "type": "boolean"
        },
        "bytes": {
          "default": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "line_count": {
          "default": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "parse_status": {
          "default": "not_parsed",
          "title": "Parse Status",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "other",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "IndexedFile",
      "type": "object"
    },
    "IndexedSymbol": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "function",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "default": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "default": 0,
          "title": "Line Start",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "title": "IndexedSymbol",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "built_at": {
      "title": "Built At",
      "type": "string"
    },
    "comment_styles": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Comment Styles",
      "type": "object"
    },
    "doc_files": {
      "items": {
        "type": "string"
      },
      "title": "Doc Files",
      "type": "array"
    },
    "excluded_paths": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Paths",
      "type": "array"
    },
    "file_count": {
      "default": 0,
