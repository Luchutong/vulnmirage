      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/IndexedFile"
      },
      "title": "Files",
      "type": "array"
    },
    "index_sha256": {
      "default": "",
      "title": "Index Sha256",
      "type": "string"
    },
    "indexer_version": {
      "default": "2026-11-05.1",
      "title": "Indexer Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sink_files": {
      "items": {
        "type": "string"
      },
      "title": "Sink Files",
      "type": "array"
    },
    "source_files": {
      "items": {
        "type": "string"
      },
      "title": "Source Files",
      "type": "array"
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/IndexedSymbol"
      },
      "title": "Symbols",
      "type": "array"
    },
    "test_files": {
      "items": {
        "type": "string"
      },
      "title": "Test Files",
      "type": "array"
    },
    "todo_lines": {
      "default": 0,
      "title": "Todo Lines",
      "type": "integer"
    },
    "total_bytes": {
      "default": 0,
      "title": "Total Bytes",
      "type": "integer"
    },
    "tree_sha256": {
      "default": "",
      "title": "Tree Sha256",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "title": "RepositoryIndex",
  "type": "object"
}
