{
  "$defs": {
    "PlanRunCell": {
      "additionalProperties": false,
      "description": "One pre-randomized audit cell in the order it must execute.",
      "properties": {
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "repetition": {
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "order",
        "repetition",
        "variant_id"
      ],
      "title": "PlanRunCell",
      "type": "object"
    },
    "PlanTarget": {
      "additionalProperties": false,
      "description": "Opaque target identity frozen without publishing the oracle target id.",
      "properties": {
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "target_ref",
        "ordinal"
      ],
      "title": "PlanTarget",
      "type": "object"
    },
    "PlanVariant": {
      "additionalProperties": false,
      "properties": {
        "base_variant_id": {
          "default": "",
          "title": "Base Variant Id",
          "type": "string"
        },
        "candidate_budget": {
          "default": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "carrier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Carrier"
        },
        "condition_id": {
          "default": "",
          "title": "Condition Id",
          "type": "string"
        },
        "edit_count": {
          "default": 0,
          "title": "Edit Count",
          "type": "integer"
        },
        "edit_paths": {
          "items": {
            "type": "string"
          },
          "title": "Edit Paths",
          "type": "array"
        },
        "generator_profile": {
          "default": "default",
          "title": "Generator Profile",
          "type": "string"
        },
        "goal": {
          "default": "none",
          "title": "Goal",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "knowledge": {
          "default": "public_context",
          "title": "Knowledge",
          "type": "string"
        },
        "method_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Id"
        },
        "payload_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Id"
        },
        "reproduction_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reproduction Status"
        },
        "selection_policy": {
          "default": "semantic_fit_then_deterministic_tiebreak",
          "title": "Selection Policy",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "tier": {
          "default": "T0",
          "title": "Tier",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "kind"
      ],
      "title": "PlanVariant",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_source_id": {
      "title": "Archive Source Id",
      "type": "string"
    },
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "effective_prompt_sha256": {
      "title": "Effective Prompt Sha256",
      "type": "string"
    },
    "eligible_target_count": {
      "default": 0,
      "title": "Eligible Target Count",
      "type": "integer"
    },
    "primary_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Language"
    },
    "repetitions": {
      "default": 1,
      "title": "Repetitions",
      "type": "integer"
    },
    "repo_id": {
      "title": "Repo Id",
      "type": "string"
    },
    "repo_url": {
      "title": "Repo Url",
      "type": "string"
    },
    "run_order": {
      "items": {
        "$ref": "#/$defs/PlanRunCell"
      },
      "title": "Run Order",
      "type": "array"
    },
    "selected_target_count": {
      "default": 0,
      "title": "Selected Target Count",
      "type": "integer"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_prompt_sha256": {
      "title": "Source Prompt Sha256",
      "type": "string"
    },
    "target_count": {
      "default": 0,
      "title": "Target Count",
      "type": "integer"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/PlanTarget"
      },
      "title": "Targets",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_prompt_rule_version": {
      "title": "Task Prompt Rule Version",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/PlanVariant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "snapshot_id",
    "repo_id",
    "repo_url",
    "commit_sha",
    "archive_source_id",
    "source_prompt_sha256",
    "effective_prompt_sha256",
    "task_prompt_rule_version"
  ],
  "title": "PlanTask",
  "type": "object"
}
