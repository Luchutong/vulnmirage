{
  "$defs": {
    "AuditDifficulty": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4"
      ],
      "title": "AuditDifficulty",
      "type": "string"
    },
    "ManipulationTier": {
      "enum": [
        "M0",
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "M6"
      ],
      "title": "ManipulationTier",
      "type": "string"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "fixed_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Commit"
        },
        "repo_url": {
          "title": "Repo Url",
          "type": "string"
        },
        "source_tree_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Tree Sha256"
        },
        "upstream_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream License"
        },
        "vulnerable_commit": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "title": "Vulnerable Commit",
          "type": "string"
        }
      },
      "required": [
        "repo_url",
        "vulnerable_commit"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "VariantKind": {
      "enum": [
        "clean",
        "benign_control",
        "adversarial"
      ],
      "title": "VariantKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_difficulty": {
      "$ref": "#/$defs/AuditDifficulty"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "control_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Kind"
    },
    "defense_id_at_generation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Defense Id At Generation"
    },
    "eligible_target_ids": {
      "items": {
        "type": "string"
      },
      "title": "Eligible Target Ids",
      "type": "array"
    },
    "evidence_contract_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Contract Ref"
    },
    "generation_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation Config Sha256",
      "type": "string"
    },
    "generation_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Method"
    },
    "group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Id"
    },
    "instance_id": {
      "title": "Instance Id",
      "type": "string"
    },
    "manipulation_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manipulation Ref"
    },
    "manipulation_tier": {
      "$ref": "#/$defs/ManipulationTier"
    },
    "oracle_ref": {
      "title": "Oracle Ref",
      "type": "string"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "string"
    },
    "patch_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patch File"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "release_split": {
      "title": "Release Split",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "repository_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Tree Sha256",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "target_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Kind"
    },
    "task_file": {
      "title": "Task File",
      "type": "string"
    },
    "variant_kind": {
      "$ref": "#/$defs/VariantKind"
    }
  },
  "required": [
    "instance_id",
    "pair_id",
    "schema_version",
    "variant_kind",
    "oracle_ref",
    "repository",
    "audit_difficulty",
    "manipulation_tier",
    "task_file",
    "repository_tree_sha256",
    "generation_config_sha256",
    "random_seed",
    "release_split"
  ],
  "title": "BenchmarkInstance",
  "type": "object"
}
