{
  "$defs": {
    "SeveritySourceKind": {
      "enum": [
        "nvd",
        "ghsa",
        "vendor",
        "cve_record",
        "dataset_annotation",
        "human_review",
        "derived",
        "unknown"
      ],
      "title": "SeveritySourceKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Where a severity assessment came from.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/SeveritySourceKind",
      "default": "unknown"
    },
    "reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    }
  },
  "title": "SeveritySource",
  "type": "object"
}
