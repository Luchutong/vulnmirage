{
  "$defs": {
    "AuditDifficulty": {
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3",
        "D4"
      ],
      "title": "AuditDifficulty",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Sha256"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "EvaluationEligibility": {
      "additionalProperties": false,
      "description": "Which attack goals a case can legitimately participate in.\n\nThis is computed by the dataset adapter (and re-checked by the generation\npipeline) so that a case without adjudicated severity can never silently\nenter a severity experiment, and a case without a verified safe target can\nnever silently enter a false-positive experiment.",
      "properties": {
        "evidence_corruption": {
          "default": true,
          "title": "Evidence Corruption",
          "type": "boolean"
        },
        "false_negative": {
          "default": true,
          "title": "False Negative",
          "type": "boolean"
        },
        "false_positive": {
          "default": false,
          "title": "False Positive",
          "type": "boolean"
        },
        "reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "object"
        },
        "severity_downgrade": {
          "default": false,
          "title": "Severity Downgrade",
          "type": "boolean"
        },
        "severity_inflation": {
          "default": false,
          "title": "Severity Inflation",
          "type": "boolean"
        },
        "verification_diversion": {
          "default": true,
          "title": "Verification Diversion",
          "type": "boolean"
        }
      },
      "title": "EvaluationEligibility",
      "type": "object"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "fixed_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixed Commit"
        },
        "repo_url": {
          "title": "Repo Url",
          "type": "string"
        },
        "source_tree_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Tree Sha256"
        },
        "upstream_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream License"
        },
        "vulnerable_commit": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "title": "Vulnerable Commit",
          "type": "string"
        }
      },
      "required": [
        "repo_url",
        "vulnerable_commit"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "SafeTargetContract": {
      "additionalProperties": false,
      "description": "A location whose *safety from a stated CWE* has been validated.\n\n``validated_safe`` may only become ``True`` after ``validator_commands``\nran with the expected exit code; the digest of the validation log is\nrecorded in ``validation_log_sha256`` so the claim is auditable.",
      "properties": {
        "cwe": {
          "title": "Cwe",
          "type": "string"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "evidence_locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Evidence Locations",
          "type": "array"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "proof_method": {
          "$ref": "#/$defs/SafeTargetProofMethod"
        },
        "safe_target_id": {
          "title": "Safe Target Id",
          "type": "string"
        },
        "safety_claim": {
          "title": "Safety Claim",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SafeTargetSource",
          "default": "human_annotation"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "validated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validated At"
        },
        "validated_safe": {
          "default": false,
          "title": "Validated Safe",
          "type": "boolean"
        },
        "validation_log_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Log Sha256"
        },
        "validator_commands": {
          "items": {
            "$ref": "#/$defs/ValidatorCommand"
          },
          "title": "Validator Commands",
          "type": "array"
        },
        "vulnerability_type": {
          "title": "Vulnerability Type",
          "type": "string"
        }
      },
      "required": [
        "safe_target_id",
        "file",
        "start_line",
        "end_line",
        "vulnerability_type",
        "cwe",
        "safety_claim",
        "proof_method"
      ],
      "title": "SafeTargetContract",
      "type": "object"
    },
    "SafeTargetProofMethod": {
      "enum": [
        "fixed_commit_path",
        "human_annotated",
        "validated_decoy"
      ],
      "title": "SafeTargetProofMethod",
      "type": "string"
    },
    "SafeTargetSource": {
      "enum": [
        "fix_commit",
        "human_annotation",
        "synthetic_decoy"
      ],
      "title": "SafeTargetSource",
      "type": "string"
    },
    "SeverityLevel": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SeverityLevel",
      "type": "string"
    },
    "SeverityRecord": {
      "additionalProperties": false,
      "description": "Structured, provenance-bearing severity assessment.\n\nA missing severity is represented by ``VulnerabilityRecord.severity is\nNone``; it must never be guessed.  Cases without a reviewed/adjudicated\nseverity are excluded from severity-manipulation experiments by\n:class:`~vulnmirage.models.safe_target.EvaluationEligibility`.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "level": {
          "$ref": "#/$defs/SeverityLevel"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "scheme": {
          "default": "cvss_v3.1",
          "title": "Scheme",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source": {
          "$ref": "#/$defs/SeveritySource"
        },
        "validation_status": {
          "$ref": "#/$defs/SeverityValidationStatus",
          "default": "unreviewed"
        },
        "vector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector"
        }
      },
      "required": [
        "level",
        "rationale"
      ],
      "title": "SeverityRecord",
      "type": "object"
    },
    "SeveritySource": {
      "additionalProperties": false,
      "description": "Where a severity assessment came from.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SeveritySourceKind",
          "default": "unknown"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "title": "SeveritySource",
      "type": "object"
    },
    "SeveritySourceKind": {
      "enum": [
        "nvd",
        "ghsa",
        "vendor",
        "cve_record",
        "dataset_annotation",
        "human_review",
        "derived",
        "unknown"
      ],
      "title": "SeveritySourceKind",
      "type": "string"
    },
    "SeverityValidationStatus": {
      "enum": [
        "unreviewed",
        "reviewed",
        "adjudicated",
        "derived"
      ],
      "title": "SeverityValidationStatus",
      "type": "string"
    },
    "ValidatorCommand": {
      "additionalProperties": false,
      "description": "An argv-array command; shell strings are deliberately impossible.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "default": ".",
          "title": "Cwd",
          "type": "string"
        },
        "env_allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Env Allowlist",
          "type": "array"
        },
        "expected_exit_codes": {
          "items": {
            "type": "integer"
          },
          "title": "Expected Exit Codes",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "argv"
      ],
      "title": "ValidatorCommand",
      "type": "object"
    },
    "VulnerabilityPath": {
      "additionalProperties": false,
      "properties": {
        "critical_operation": {
          "$ref": "#/$defs/CodeLocation"
        },
        "entry_point": {
          "$ref": "#/$defs/CodeLocation"
        },
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Trace",
          "type": "array"
        }
      },
      "required": [
        "path_id",
        "entry_point",
        "critical_operation"
      ],
      "title": "VulnerabilityPath",
      "type": "object"
    },
    "VulnerabilityRecord": {
      "additionalProperties": false,
      "properties": {
        "affected_files": {
          "items": {
            "type": "string"
          },
          "title": "Affected Files",
          "type": "array"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "category_l1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category L1"
        },
        "category_l2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category L2"
        },
        "cwe": {
          "items": {
            "type": "string"
          },
          "title": "Cwe",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/VulnerabilityPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "poc_commands": {
          "items": {
            "$ref": "#/$defs/ValidatorCommand"
          },
          "title": "Poc Commands",
          "type": "array"
        },
        "regression_commands": {
          "items": {
            "$ref": "#/$defs/ValidatorCommand"
          },
          "title": "Regression Commands",
          "type": "array"
        },
        "root_cause": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Cause"
        },
        "safe_targets": {
          "items": {
            "$ref": "#/$defs/SafeTargetContract"
          },
          "title": "Safe Targets",
          "type": "array"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeverityRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "vulnerability_id": {
          "title": "Vulnerability Id",
          "type": "string"
        }
      },
      "required": [
        "vulnerability_id",
        "title",
        "paths",
        "affected_files"
      ],
      "title": "VulnerabilityRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "difficulty_source": {
      "title": "Difficulty Source",
      "type": "string"
    },
    "evaluation_eligibility": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationEligibility"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_difficulty": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditDifficulty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hidden_metadata": {
      "additionalProperties": true,
      "title": "Hidden Metadata",
      "type": "object"
    },
    "oracle_id": {
      "title": "Oracle Id",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "safe_targets": {
      "items": {
        "$ref": "#/$defs/SafeTargetContract"
      },
      "title": "Safe Targets",
      "type": "array"
    },
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_dataset": {
      "title": "Source Dataset",
      "type": "string"
    },
    "source_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Record Ids",
      "type": "array"
    },
    "suggested_difficulty": {
      "$ref": "#/$defs/AuditDifficulty"
    },
    "validation_level": {
      "title": "Validation Level",
      "type": "string"
    },
    "vulnerabilities": {
      "items": {
        "$ref": "#/$defs/VulnerabilityRecord"
      },
      "title": "Vulnerabilities",
      "type": "array"
    }
  },
  "required": [
    "oracle_id",
    "source_dataset",
    "repository",
    "vulnerabilities",
    "suggested_difficulty",
    "difficulty_source",
    "validation_level"
  ],
  "title": "CanonicalVulnerabilityOracle",
  "type": "object"
}
