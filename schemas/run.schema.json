{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Manifest Path"
    },
    "artifact_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Sha256",
      "type": "object"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "audit_scope": {
      "additionalProperties": true,
      "title": "Audit Scope",
      "type": "object"
    },
    "condition_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition Id"
    },
    "condition_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition Source"
    },
    "defense_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Defense Id"
    },
    "defense_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Defense Version"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "enriched_trajectory_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Enriched Trajectory Path"
    },
    "event_count": {
      "default": 0,
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "execution_condition": {
      "additionalProperties": true,
      "title": "Execution Condition",
      "type": "object"
    },
    "external_file_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "External File Sha256",
      "type": "object"
    },
    "file_access_count": {
      "default": 0,
      "minimum": 0,
      "title": "File Access Count",
      "type": "integer"
    },
    "file_access_path": {
      "title": "File Access Path",
      "type": "string"
    },
    "final_raw_path": {
      "title": "Final Raw Path",
      "type": "string"
    },
    "findings_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Findings Path"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "instance_id": {
      "title": "Instance Id",
      "type": "string"
    },
    "isolation_enforcement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Isolation Enforcement"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "model_provider": {
      "title": "Model Provider",
      "type": "string"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "network_enabled": {
      "default": false,
      "title": "Network Enabled",
      "type": "boolean"
    },
    "normalized_events_path": {
      "title": "Normalized Events Path",
      "type": "string"
    },
    "observability_grade": {
      "pattern": "^[ABCD]$",
      "title": "Observability Grade",
      "type": "string"
    },
    "observation_capabilities": {
      "additionalProperties": true,
      "title": "Observation Capabilities",
      "type": "object"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "planned_repetitions": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Repetitions"
    },
    "process_events_path": {
      "title": "Process Events Path",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "purpose": {
      "default": "evaluation",
      "title": "Purpose",
      "type": "string"
    },
    "raw_events_path": {
      "title": "Raw Events Path",
      "type": "string"
    },
    "repetition": {
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scaffold": {
      "title": "Scaffold",
      "type": "string"
    },
    "scaffold_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scaffold Version"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "stderr_path": {
      "title": "Stderr Path",
      "type": "string"
    },
    "stdout_path": {
      "title": "Stdout Path",
      "type": "string"
    },
    "time_budget_seconds": {
      "minimum": 1,
      "title": "Time Budget Seconds",
      "type": "integer"
    },
    "token_budget": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Token Budget"
    },
    "tool_call_count": {
      "default": 0,
      "minimum": 0,
      "title": "Tool Call Count",
      "type": "integer"
    },
    "tool_calls_path": {
      "title": "Tool Calls Path",
      "type": "string"
    },
    "tool_policy": {
      "additionalProperties": true,
      "title": "Tool Policy",
      "type": "object"
    },
    "tool_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Tokens"
    },
    "verification_assessments_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Assessments Path"
    }
  },
  "required": [
    "run_id",
    "instance_id",
    "repetition",
    "model_provider",
    "model_name",
    "scaffold",
    "prompt_sha256",
    "time_budget_seconds",
    "started_at",
    "ended_at",
    "status",
    "raw_events_path",
    "normalized_events_path",
    "tool_calls_path",
    "file_access_path",
    "process_events_path",
    "observability_grade",
    "stdout_path",
    "stderr_path",
    "final_raw_path"
  ],
  "title": "AgentRun",
  "type": "object"
}
