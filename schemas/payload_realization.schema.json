{
  "$defs": {
    "AttackSurface": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "enum": [
            "S-DOC",
            "S-RULE",
            "S-COMMENT",
            "S-CODE",
            "S-CONFIG",
            "S-TEST",
            "S-META",
            "S-GENERATED",
            "S-TOOL"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "zone": {
          "enum": [
            "Z-AUTO",
            "Z-ROOT",
            "Z-TARGET",
            "Z-ENTRY",
            "Z-SINK",
            "Z-PATH",
            "Z-PERIPHERAL"
          ],
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "zone"
      ],
      "title": "AttackSurface",
      "type": "object"
    },
    "MethodPlacementLimits": {
      "additionalProperties": false,
      "properties": {
        "max_files_changed": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Files Changed",
          "type": "integer"
        },
        "max_inserted_lines": {
          "default": 8,
          "maximum": 400,
          "minimum": 1,
          "title": "Max Inserted Lines",
          "type": "integer"
        },
        "max_payload_chars": {
          "default": 4000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Max Payload Chars",
          "type": "integer"
        }
      },
      "title": "MethodPlacementLimits",
      "type": "object"
    },
    "MethodValidationPolicy": {
      "additionalProperties": false,
      "properties": {
        "answer_token_scan": {
          "default": true,
          "title": "Answer Token Scan",
          "type": "boolean"
        },
        "build_equivalence": {
          "default": "when_profile_available",
          "enum": [
            "required",
            "when_profile_available",
            "not_applicable"
          ],
          "title": "Build Equivalence",
          "type": "string"
        },
        "parse_required": {
          "default": true,
          "title": "Parse Required",
          "type": "boolean"
        },
        "target_remap_required": {
          "default": true,
          "title": "Target Remap Required",
          "type": "boolean"
        }
      },
      "title": "MethodValidationPolicy",
      "type": "object"
    },
    "RealizationDose": {
      "additionalProperties": false,
      "description": "Auditable dose supplied by one concrete realization.\n\nThese counts are author-declared structural properties of the payload, not a\npost-hoc estimate of how persuasive it was. Catalog validation checks them\nagainst both the method-specific profile and the generic I0-I4 ordering.",
      "properties": {
        "claim_count": {
          "maximum": 16,
          "minimum": 1,
          "title": "Claim Count",
          "type": "integer"
        },
        "directness": {
          "enum": [
            "implicit",
            "explicit"
          ],
          "title": "Directness",
          "type": "string"
        },
        "reinforcement_count": {
          "default": 0,
          "maximum": 16,
          "minimum": 0,
          "title": "Reinforcement Count",
          "type": "integer"
        },
        "supporting_evidence_count": {
          "maximum": 32,
          "minimum": 0,
          "title": "Supporting Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "claim_count",
        "supporting_evidence_count",
        "directness"
      ],
      "title": "RealizationDose",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One concrete expression of a method at one surface and intensity.",
  "properties": {
    "allowed_threat_models": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Threat Models",
      "type": "array"
    },
    "carrier": {
      "title": "Carrier",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "dose": {
      "$ref": "#/$defs/RealizationDose"
    },
    "generator_backends": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Generator Backends",
      "type": "object"
    },
    "inspiration_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inspiration Scope"
    },
    "intensity": {
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3",
        "I4"
      ],
      "title": "Intensity",
      "type": "string"
    },
    "known_deviations": {
      "items": {
        "type": "string"
      },
      "title": "Known Deviations",
      "type": "array"
    },
    "language": {
      "default": "repository_native",
      "title": "Language",
      "type": "string"
    },
    "method_id": {
      "title": "Method Id",
      "type": "string"
    },
    "objective": {
      "enum": [
        "O-FN",
        "O-FP",
        "O-SEV-D",
        "O-SEV-I",
        "O-EV",
        "O-SCOPE",
        "O-AVAIL"
      ],
      "title": "Objective",
      "type": "string"
    },
    "output_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Path"
    },
    "placement": {
      "enum": [
        "create_file",
        "target_file_footer",
        "safe_decoy_file"
      ],
      "title": "Placement",
      "type": "string"
    },
    "placement_limits": {
      "$ref": "#/$defs/MethodPlacementLimits"
    },
    "private_safety_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Private Safety Basis"
    },
    "realization_id": {
      "title": "Realization Id",
      "type": "string"
    },
    "reproduction_status": {
      "enum": [
        "implemented_adaptation",
        "planned"
      ],
      "title": "Reproduction Status",
      "type": "string"
    },
    "safe_decoy_cwe_ids": {
      "items": {
        "type": "string"
      },
      "title": "Safe Decoy Cwe Ids",
      "type": "array"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "supported_generator_tiers": {
      "items": {
        "enum": [
          "T0",
          "T1",
          "T2",
          "T3",
          "T4"
        ],
        "type": "string"
      },
      "title": "Supported Generator Tiers",
      "type": "array"
    },
    "surface": {
      "$ref": "#/$defs/AttackSurface"
    },
    "template": {
      "title": "Template",
      "type": "string"
    },
    "templates": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Templates",
      "type": "object"
    },
    "validation": {
      "$ref": "#/$defs/MethodValidationPolicy"
    }
  },
  "required": [
    "realization_id",
    "method_id",
    "objective",
    "surface",
    "intensity",
    "dose",
    "reproduction_status",
    "carrier",
    "placement",
    "template"
  ],
  "title": "PayloadRealizationDefinition",
  "type": "object"
}
