{
  "$defs": {
    "PhaseRecord": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "phase"
      ],
      "title": "PhaseRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archive Sha256"
    },
    "config_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Sha256"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "failed_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Run Ids",
      "type": "array"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/PhaseRecord"
      },
      "title": "History",
      "type": "array"
    },
    "ineligible_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Ineligible Run Ids",
      "type": "array"
    },
    "notes": {
      "additionalProperties": true,
      "title": "Notes",
      "type": "object"
    },
    "phase": {
      "default": "pending",
      "title": "Phase",
      "type": "string"
    },
    "plan_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Sha256"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Scored Run Ids",
      "type": "array"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "source_tree_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tree Sha256"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "variant_ids": {
      "items": {
        "type": "string"
      },
      "title": "Variant Ids",
      "type": "array"
    }
  },
  "required": [
    "task_id"
  ],
  "title": "TaskState",
  "type": "object"
}
