{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One T3/T4 optimization query, kept apart from formal repetitions.",
  "properties": {
    "answer_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Sha256"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "cost_units": {
      "default": 0.0,
      "title": "Cost Units",
      "type": "number"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "phase": {
      "default": "adaptation",
      "enum": [
        "adaptation",
        "evaluation"
      ],
      "title": "Phase",
      "type": "string"
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Sha256"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "tokens": {
      "default": 0,
      "title": "Tokens",
      "type": "integer"
    },
    "wall_clock_seconds": {
      "default": 0.0,
      "title": "Wall Clock Seconds",
      "type": "number"
    }
  },
  "required": [
    "query_id"
  ],
  "title": "AdaptationQuery",
  "type": "object"
}
