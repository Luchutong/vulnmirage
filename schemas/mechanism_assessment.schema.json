{
  "$defs": {
    "MechanismLabel": {
      "additionalProperties": false,
      "properties": {
        "alternative_explanations": {
          "items": {
            "type": "string"
          },
          "title": "Alternative Explanations",
          "type": "array"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "counterevidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterevidence"
        },
        "evidence_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Event Ids",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "report_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Span"
        },
        "requirement": {
          "default": "",
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "MechanismLabel",
      "type": "object"
    },
    "RunAssessment": {
      "additionalProperties": false,
      "properties": {
        "detected_targets": {
          "items": {
            "type": "string"
          },
          "title": "Detected Targets",
          "type": "array"
        },
        "exposure_state": {
          "default": "unknown",
          "title": "Exposure State",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/MechanismLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "missed_targets": {
          "items": {
            "type": "string"
          },
          "title": "Missed Targets",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "variant_id",
        "kind"
      ],
      "title": "RunAssessment",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "label_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Label Counts",
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "rule_version": {
      "default": "1.0",
      "title": "Rule Version",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunAssessment"
      },
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "unknown",
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    }
  },
  "title": "MechanismReport",
  "type": "object"
}
