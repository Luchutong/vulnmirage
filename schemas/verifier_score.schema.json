{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detection": {
      "additionalProperties": true,
      "title": "Detection",
      "type": "object"
    },
    "diagnosis": {
      "additionalProperties": true,
      "title": "Diagnosis",
      "type": "object"
    },
    "eligibility": {
      "default": "unknown",
      "title": "Eligibility",
      "type": "string"
    },
    "false_positive": {
      "additionalProperties": true,
      "title": "False Positive",
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "produced_at": {
      "title": "Produced At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scored": {
      "default": false,
      "title": "Scored",
      "type": "boolean"
    },
    "severity": {
      "additionalProperties": true,
      "title": "Severity",
      "type": "object"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "trace": {
      "additionalProperties": true,
      "title": "Trace",
      "type": "object"
    },
    "variant_id": {
      "title": "Variant Id",
      "type": "string"
    },
    "variant_kind": {
      "title": "Variant Kind",
      "type": "string"
    },
    "variant_set_id": {
      "default": "inline",
      "title": "Variant Set Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "run_id",
    "variant_id",
    "variant_kind"
  ],
  "title": "RunScore",
  "type": "object"
}
