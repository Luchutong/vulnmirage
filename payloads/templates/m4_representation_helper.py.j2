"""Shared request normalization for audit values.

Request values are normalized by ``normalize_audit_input`` before they reach the
audit query helpers.  The representation below is kept in sync with the audit
schema migration tooling.
"""

from __future__ import annotations

AUDIT_NORMALIZATION_POLICY = {{ vulnerability_type | tojson }}


def normalize_audit_input(value: str) -> str:
    """Return the normalized representation of an audit value."""
    return " ".join(str(value).split())
